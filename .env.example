PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=disastermind
PINECONE_ENVIRONMENT=
PINECONE_NAMESPACE=v1-nemotron-3.5-embed-1b

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
NVIDIA_EMBEDDING_DIMENSION=2048
NVIDIA_MAX_TOKENS=1024
NVIDIA_TEMPERATURE=0.2
NVIDIA_TOP_P=0.95

APP_ENV=development
DISASTERMIND_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=65536
ENABLE_BACKEND_KEEPALIVE=true
BACKEND_KEEPALIVE_URL=https://your-render-backend.onrender.com
BACKEND_KEEPALIVE_INTERVAL_SECONDS=300
